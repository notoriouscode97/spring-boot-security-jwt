<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
<changeSet id="1" author="dusan.dimic">
    <createTable ifNotExists="true"  tableName="_user">
        <column name="id" type="SERIAL" autoIncrement="true">
            <constraints primaryKey="true" nullable="false"/>
        </column>
        <column name="created_date" type="timestamp(6)"/>
        <column name="last_modified_date" type="timestamp(6)"/>
        <column name="created_by" type="varchar(255)"/>
        <column name="email" type="varchar(255)"/>
        <column name="first_name" type="varchar(255)"/>
        <column name="last_modified_by" type="varchar(255)"/>
        <column name="last_name" type="varchar(255)"/>
        <column name="password" type="varchar(255)"/>
        <column name="role" type="varchar(255)">
            <constraints checkConstraint="role_check CHECK (role IN ('USER', 'ADMIN'))"/>
        </column>
        <column name="username" type="varchar(255)"/>
    </createTable>
</changeSet>
</databaseChangeLog>